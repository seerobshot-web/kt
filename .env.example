# Square payments — required for the checkout card form to appear and charge.
# Get these from https://developer.squareup.com/apps (Credentials + Locations).
#
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time.
# When deploying (e.g. Vercel), set them in the hosting dashboard and REDEPLOY —
# without them the card input on /checkout will not render.

# Public (browser) keys
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# 'production' or 'sandbox'. If unset, inferred from the application id
# (sandbox ids start with "sandbox-").
NEXT_PUBLIC_SQUARE_ENVIRONMENT=production

# Server-only keys (never exposed to the browser)
SQUARE_ACCESS_TOKEN=
# Optional: defaults to NEXT_PUBLIC_SQUARE_LOCATION_ID
SQUARE_LOCATION_ID=
# Optional: defaults to NEXT_PUBLIC_SQUARE_ENVIRONMENT, then 'production'
SQUARE_ENVIRONMENT=production

# Order notification email (optional — skipped if SMTP_PASS is unset)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@kingdomtreatzrva.com
SMTP_PASS=
