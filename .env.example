# Square payments. Get these from https://developer.squareup.com/apps
# (Credentials + Locations).
#
# The customer-facing /checkout flow uses Square Payment Links — the customer
# is redirected to a Square-hosted page to pay, so no card form is embedded
# on this site and NEXT_PUBLIC_SQUARE_* are not required for it to work.
# The admin /admin/take-payment and balance-collection flows still use the
# Web Payments SDK (staff take a card over the phone/in person), so those
# NEXT_PUBLIC_* values are still required for the /admin portal to work.
#
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time.
# When deploying (e.g. Vercel), set them in the hosting dashboard and REDEPLOY.

# Public (browser) keys — required for /admin card input only
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# 'production' or 'sandbox'. If unset, inferred from the application id
# (sandbox ids start with "sandbox-").
NEXT_PUBLIC_SQUARE_ENVIRONMENT=production

# Server-only keys (never exposed to the browser)
SQUARE_ACCESS_TOKEN=
# Optional: defaults to NEXT_PUBLIC_SQUARE_LOCATION_ID
SQUARE_LOCATION_ID=
# Optional: defaults to NEXT_PUBLIC_SQUARE_ENVIRONMENT, then 'production'
SQUARE_ENVIRONMENT=production

# Webhook subscription (Square Developer Dashboard > your app > Webhooks).
# Required for /checkout to confirm payment and email the order notification.
# Subscribe to the "payment.updated" event type, pointed at:
#   SQUARE_WEBHOOK_NOTIFICATION_URL, e.g. https://kingdomtreatzrva.com/api/webhooks/square
# SQUARE_WEBHOOK_SIGNATURE_KEY is the signature key Square shows for that
# subscription — both values must match exactly what's configured there, since
# the signature is computed over the notification URL string itself.
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Order notification email (optional — skipped if SMTP_PASS is unset)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@kingdomtreatzrva.com
SMTP_PASS=

# Staff-only /admin portal — required for admin login and session cookies.
# Shared passcode staff type in to unlock /admin (no per-user accounts).
ADMIN_PASSCODE=
# Secret used to sign the admin session JWT cookie. Use a long random string.
ADMIN_SESSION_SECRET=
